{
  "name": "@mscode-pl/email-lint",
  "version": "0.2.1",
  "description": "Find the CSS and HTML in your emails that Outlook, Gmail, Apple Mail and other clients will break, with line numbers. Ships an MCP server and a GitHub Action. Works with React Email, MJML, Maizzle, Laravel and plain HTML.",
  "mcpName": "io.github.mscode-pl/email-lint",
  "license": "MIT",
  "author": "MSCode (https://mscode.pl)",
  "type": "module",
  "homepage": "https://github.com/mscode-pl/email-lint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mscode-pl/email-lint.git"
  },
  "bugs": "https://github.com/mscode-pl/email-lint/issues",
  "keywords": [
    "email",
    "html-email",
    "lint",
    "linter",
    "caniemail",
    "outlook",
    "gmail",
    "react-email",
    "mjml",
    "maizzle",
    "cli",
    "mcp",
    "mcp-server",
    "github-action"
  ],
  "bin": {
    "email-lint": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "update-data": "node scripts/update-data.mjs",
    "screenshot": "pnpm build && node scripts/render-screenshot.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "domhandler": "^6.0.1",
    "htmlparser2": "^12.0.0",
    "postcss": "^8.5.33"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
