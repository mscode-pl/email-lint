{
  "name": "@mscode-pl/email-lint",
  "version": "0.1.0",
  "description": "Check email HTML against caniemail.com support data. Works with any HTML: React Email, MJML, Maizzle, Laravel, hand-written.",
  "license": "MIT",
  "type": "module",
  "repository": "https://github.com/mscode-pl/email-lint",
  "keywords": [
    "email",
    "html-email",
    "lint",
    "caniemail",
    "outlook",
    "gmail",
    "react-email",
    "mjml"
  ],
  "bin": {
    "email-lint": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "update-data": "node scripts/update-data.mjs"
  },
  "dependencies": {
    "domhandler": "^6.0.1",
    "htmlparser2": "^12.0.0",
    "postcss": "^8.5.33"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
